import builtins
from typing import Any

from box.box import Box as Box

class ConfigBox(Box):
    def __dir__(self) -> list[str]: ...
    def bool(self, item: Any, default: Any | None = ...): ...
    def int(self, item: Any, default: Any | None = ...): ...
    def float(self, item: Any, default: Any | None = ...): ...
    def list(
        self,
        item: Any,
        default: Any | None = ...,
        spliter: str = ...,
        strip: builtins.bool = ...,
        mod: Any | None = ...,
    ): ...
    def getboolean(self, item: Any, default: Any | None = ...): ...
    def getint(self, item: Any, default: Any | None = ...): ...
    def getfloat(self, item: Any, default: Any | None = ...): ...
